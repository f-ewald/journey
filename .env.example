# Mapbox access token. Create one at https://account.mapbox.com/access-tokens/
# Copy this file to `.env` (gitignored) and paste your token below.
VITE_MAPBOX_TOKEN=

# Optional. Stamen basemaps (mapStyle: watercolor | terrain | toner) load without
# one, but that anonymous access is rate limited. Get a key at stadiamaps.com.
VITE_STADIA_API_KEY=
